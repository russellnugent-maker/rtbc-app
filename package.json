{
  "name": "rtbc-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist/app --emptyOutDir && cp -r landing/. dist/",
    "build:native": "vite build --mode native --outDir dist-native --emptyOutDir",
    "test": "node --test 'src/**/*.test.js' 'netlify/**/*.test.mjs'",
    "test:screens": "node --test tests/screens.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:native": "node scripts/check-native-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "1.65.0",
    "vite": "^8.3.6"
  }
}
